# ==========================================================
# ESP32 GPS Tracker - environment template (reference copy)
# ==========================================================
# The backend loads its real values from  backend/.env
# The frontend loads its real values from frontend/.env
#
# Quick start:
#   cp .env.example backend/.env
#   cp frontend/.env.example frontend/.env
#
# ------------------------------------------------------------------
# BACKEND  (backend/.env)
# ------------------------------------------------------------------

NODE_ENV=development
HOST=0.0.0.0
PORT=4000

# Key the ESP32 must send:  Authorization: Bearer <API_SECRET>
# Generate one with:
#   node -e "console.log('gps_live_'+require('crypto').randomBytes(24).toString('hex'))"
API_SECRET=change_me_generate_a_long_random_string

# OPTIONAL read-only key for the browser dashboard. Empty = public reads.
# Must be a DIFFERENT key from API_SECRET - the device key never ships to a browser.
DASHBOARD_API_KEY=

# Database: sqlite (default, zero-config) or postgres
DB_CLIENT=sqlite
SQLITE_PATH=./data/gps-tracker.db
# DATABASE_URL=postgres://user:password@localhost:5432/gps_tracker
# PGSSLMODE=require

# Tracker behaviour
DEVICE_ID=GPS_TRACKING
DEVICE_NAME=GPS TRACKING
OFFLINE_TIMEOUT_SECONDS=30
REJECT_NULL_ISLAND=true

# CORS: comma separated origins, or * in development
CORS_ORIGINS=*
INGEST_RATE_LIMIT_PER_MINUTE=120
GLOBAL_RATE_LIMIT_PER_MINUTE=600

# ------------------------------------------------------------------
# FRONTEND  (frontend/.env)
# ------------------------------------------------------------------

# Empty in development: the Vite dev server proxies /api + /socket.io to :4000
VITE_API_URL=
# OPTIONAL read-only dashboard key (never the ESP32 device key)
VITE_DASHBOARD_API_KEY=

# ------------------------------------------------------------------
# ESP32  (esp32/secrets.h  <-  copy of esp32/secrets.h.example)
# ------------------------------------------------------------------
# WIFI_SSID, WIFI_PASSWORD, API_BASE_URL, API_SECRET, DEVICE_ID
