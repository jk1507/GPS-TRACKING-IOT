# ==========================================================
# ESP32 GPS Tracker - backend environment
# Copy this file to `.env` and fill in your own values:
#   cp .env.example .env
# ==========================================================

NODE_ENV=development
HOST=0.0.0.0
PORT=4000

# ----------------------------------------------------------
# API key used by the ESP32 when POSTing /api/location
# The device sends:  Authorization: Bearer <API_SECRET>
# Generate a new one with:
#   node -e "console.log('gps_live_'+require('crypto').randomBytes(24).toString('hex'))"
# ----------------------------------------------------------
API_SECRET=change_me_generate_a_long_random_string

# ----------------------------------------------------------
# OPTIONAL read-only key for the dashboard (browser).
# Leave EMPTY for local development (dashboards are public on your LAN).
# If set, the frontend must send it as `Authorization: Bearer <key>`
# (frontend/.env -> VITE_DASHBOARD_API_KEY).
# It is a SEPARATE key so the device ingest key is never shipped to a browser.
# ----------------------------------------------------------
DASHBOARD_API_KEY=

# ----------------------------------------------------------
# Database.  DB_CLIENT=sqlite  (default, zero-config dev)
#            DB_CLIENT=postgres -> uses DATABASE_URL below
# ----------------------------------------------------------
DB_CLIENT=sqlite
SQLITE_PATH=./data/gps-tracker.db
# DATABASE_URL=postgres://user:password@localhost:5432/gps_tracker
# PGSSLMODE=require

# ----------------------------------------------------------
# Tracker behaviour
# ----------------------------------------------------------
DEVICE_ID=GPS_TRACKING
DEVICE_NAME=GPS TRACKING
# Device is OFFLINE when no update arrived within this many seconds
OFFLINE_TIMEOUT_SECONDS=30
# Reject (0,0) "null island" payloads, which mean "no GPS fix"
REJECT_NULL_ISLAND=true

# ----------------------------------------------------------
# CORS: comma separated list of allowed origins, `*` allows all.
# In production set this to your site, e.g.
# CORS_ORIGINS=https://tracker.example.com
# ----------------------------------------------------------
CORS_ORIGINS=*

# Rate limiting
INGEST_RATE_LIMIT_PER_MINUTE=120
GLOBAL_RATE_LIMIT_PER_MINUTE=600
