# ==========================================================
# ESP32 GPS Tracker - frontend environment
# Copy to `.env` if you need to override the defaults.
#   cp .env.example .env
# ==========================================================

# Backend base URL.
# Leave EMPTY in development: the Vite dev server proxies /api and
# /socket.io to http://localhost:4000 automatically.
# Set this to your public API origin in production, e.g.
#   VITE_API_URL=https://gps-api.example.com
VITE_API_URL=

# OPTIONAL read-only dashboard key. Only needed when the backend sets
# DASHBOARD_API_KEY. This is a READ-ONLY key.
# NEVER put the ESP32 device API_SECRET here - it would end up in the
# public JavaScript bundle.
VITE_DASHBOARD_API_KEY=
