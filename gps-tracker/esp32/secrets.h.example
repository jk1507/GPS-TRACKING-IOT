// ==========================================================
// ESP32 GPS Tracker - private credentials
//
// Copy this file to `secrets.h` (same folder as gps_tracker.ino)
// and fill in your own values. `secrets.h` is gitignored so your
// Wi-Fi password and API key never reach the repository.
//
//     cp secrets.h.example secrets.h
// ==========================================================

#pragma once

// ---- Wi-Fi (use a 2.4 GHz network, the ESP32 has no 5 GHz radio) ----
#define WIFI_SSID       "YOUR_WIFI_NAME"
#define WIFI_PASSWORD   "YOUR_WIFI_PASSWORD"

// ---- Backend ----
// Base URL of your backend, WITHOUT a trailing slash and WITHOUT /api.
//   Local:       http://192.168.1.50:4000
//   Production:  https://gps-api.example.com
// The sketch appends "/api/location".
#define API_BASE_URL    "http://192.168.1.50:4000"

// Must match API_SECRET in backend/.env exactly.
#define API_SECRET      "change_me_generate_a_long_random_string"

// Identifies this tracker. Matches DEVICE_ID in backend/.env.
#define DEVICE_ID       "GPS_TRACKING"
